<mxfile host="Electron" agent="CloudSentinel" version="24.0.0"><diagram id="cloudsentinel-arch" name="CloudSentinel architecture"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style=&quot;font-size:26px&quot;&gt;CloudSentinel&lt;/b&gt;&lt;span style=&quot;font-size:26px;color:#5F6B7A&quot;&gt; · AWS threat detection and alerting pipeline&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Phase 1 · live in us-east-1 · deployed with Terraform · 5 detections mapped to MITRE ATT&amp;amp;CK · all 5 attack-tested end to end" style="text;html=1;fontFamily=Helvetica;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=14;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="26" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Any identity&lt;/b&gt;&lt;br&gt;IAM user, role or root&lt;br&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;console, CLI or SDK&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontFamily=Helvetica;aspect=fixed;shape=mxgraph.aws4.user;whiteSpace=nowrap;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="292" width="64" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;AWS Cloud&lt;/b&gt; (single account)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontFamily=Helvetica;fontS